# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.
#
# Most secrets now live in Infisical and are injected at deploy time by
# `infisical run` (see the Makefile). What remains here is only what Infisical
# cannot supply:
#
#   1. Infisical CLI credentials  — needed to reach Infisical at all
#   2. Bootstrap secrets          — consumed by `make deploy-infisical`, which
#                                   runs BEFORE Infisical exists
#   3. Connection / config vars   — not stored in Infisical (see the last section)
#
# Everything else is listed at the bottom under "Managed in Infisical" — do not
# add those back here. A stale copy in .env silently shadows nothing (Infisical
# wins), but it does leave plaintext secrets on disk for no benefit.

# === 1. Infisical CLI (required after Infisical is deployed) ===
# Create a machine identity in the Infisical UI:
#   Organization → Access Control → Identities → Create → Universal Auth
#   Then assign it to the project with at least Viewer/Reader on the prod
#   environment — an identity with no project grant makes every deploy fail
#   the `_infisical-check` guard.
#
# INFISICAL_API_URL must be the LAN address. The Cloudflare Tunnel hostname sits
# behind Cloudflare Access, which answers unauthenticated API calls with a 302
# to a login page — the CLI reads that as "no secrets" rather than an error.
INFISICAL_API_URL=http://10.x.x.x:8080
INFISICAL_PROJECT_ID=<project-id-from-infisical-ui>
INFISICAL_CLIENT_ID=<machine-identity-client-id>
INFISICAL_CLIENT_SECRET=<machine-identity-client-secret>

# === 2. Bootstrap secrets (used by `make deploy-infisical`) ===
# `make deploy-infisical` runs the docker, postgresql, and infisical roles
# without Infisical injection — it is what brings Infisical up in the first
# place. Every value below is rendered by those roles, so it cannot come from
# Infisical. Duplicates of these also live in Infisical for normal deploys;
# keep the two in sync when you rotate.

# PostgreSQL password for the infisical database user
# Requirements: min 16 chars, mix of letters and digits recommended
# Generate with: openssl rand -base64 16
POSTGRESQL_PASSWORD=changeme

# Redis password — embedded in the redis:// URL the infisical role renders.
# Requirements: min 32 chars; hex only — base64 chars (/ =) break URL parsing
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=changeme

# Infisical at-rest encryption key — must be exactly 32 characters
# Used directly as AES-256 key (32 bytes raw); do NOT use base64 or longer hex
# CRITICAL: never change this after first deploy; all stored secrets become
# unrecoverable. Never store this one in Infisical itself.
# Generate with: openssl rand -hex 16
INFISICAL_ENCRYPTION_KEY=changeme

# Infisical JWT signing secret — any long random string
# Requirements: min 32 chars
# Generate with: openssl rand -hex 32
INFISICAL_AUTH_SECRET=changeme

# URL clients use to reach Infisical (must match actual LAN IP/hostname)
INFISICAL_SITE_URL=http://10.x.x.x:8080

# Public CF Tunnel URL for Infisical (optional).
# When set, SITE_URL in infisical.env is overridden to this value so that Google
# OAuth redirect URIs and email links use the public hostname instead of the LAN
# IP. Omit if Infisical is LAN-only.
INFISICAL_EXTERNAL_URL=https://infisical.yourdomain.com

# Infisical Google OAuth (optional — enables Sign in with Google).
# Same Google identity as Cloudflare Access; users sign in once per browser.
# Setup: console.cloud.google.com → APIs & Services → Credentials →
#        Create OAuth 2.0 Client ID → Application type: Web application
#   Authorized redirect URI: https://infisical.yourdomain.com/api/v1/sso/google
#     (use INFISICAL_EXTERNAL_URL if set, else http://SIEM_SERVER_IP:8080/api/v1/sso/google)
INFISICAL_CLIENT_ID_GOOGLE=
INFISICAL_CLIENT_SECRET_GOOGLE=

# === 3. Connection ===
# SIEM_SERVER_IP / _USER and POSTGRESQL_SERVER_IP / _USER become ansible_host
# and ansible_user, so they must be readable before Infisical is reachable.
# REDIS_SERVER_IP is rendered into Infisical's REDIS_URL at bootstrap.
SIEM_SERVER_IP=10.x.x.x
SIEM_SERVER_USER=yourusername

# PostgreSQL runs on siem_server — set to same IP as SIEM_SERVER_IP
POSTGRESQL_SERVER_IP=10.x.x.x
POSTGRESQL_SERVER_USER=yourusername

# Redis runs natively on a separate node (RPi4) — immune to RPi5 jemalloc/16KB-page crash
REDIS_SERVER_IP=10.x.x.x

# === 4. Config not stored in Infisical ===
# Not secret, but consumed by every deploy via lookup('env', ...). These are
# absent from the Infisical project, so a deploy run without .env present
# renders them empty — which is how Grafana JWT auth silently broke once.
# Consider moving them into Infisical; until then they must stay here.

# Public URL Grafana embeds in alert notification links.
# Without this, alert links point to http://localhost:3000 (useless in notifications).
GRAFANA_EXTERNAL_URL=https://grafana.yourdomain.com

# Cloudflare Access team name — enables JWT auth so users log in via Cloudflare
# Access instead of Grafana's own login form. Find it at:
# one.dash.cloudflare.com → Access → Settings.
# Example: team domain "myteam.cloudflareaccess.com" → set this to "myteam".
# Omit to keep Grafana's built-in login.
CLOUDFLARE_TEAM_NAME=

# ntfy topic name on the primary self-hosted server (defaults to "homelab")
NTFY_TOPIC=homelab

# Unifi controller URLs. Port is 443 for UDM/Dream Machine, 8443 for older
# CloudKey/software controllers. The matching usernames and passwords live in
# Infisical — create a read-only local user in each controller:
#   UnifiOS (UDM/Dream Machine): Settings → Admins → Add Admin → Role: Read Only
UNIFI_CONTROLLER_URL_SITE1=https://10.x.x.x:443
UNIFI_CONTROLLER_URL_SITE2=https://10.x.x.x:443

# === Managed in Infisical — do NOT add these back to .env ===
# Everything else is injected at deploy time by `infisical run`. The full list,
# with each secret's requirements and generation command, is in
# infisical-secrets.template.env — that file is also the import source for a
# fresh project, and `make _infisical-check` enforces it on every deploy.
#
# Verify what the machine identity can actually see (prints values — run privately):
#   make env
