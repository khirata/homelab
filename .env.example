# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.
#
# After Infisical is deployed, most secrets below move into Infisical.
# Only the following groups are still needed in .env:
#   - Connection vars (used by Make for SSH and ansible_host)
#   - Infisical CLI credentials (used by Make to authenticate to Infisical)
#   - Infisical bootstrap secrets (INFISICAL_ENCRYPTION_KEY, INFISICAL_AUTH_SECRET —
#     used by `make deploy-infisical` before Infisical is running)

# === Infisical CLI (required after Infisical is deployed) ===
# Create a machine identity in Infisical UI:
#   Settings → Machine Identities → Create → Universal Auth
#   Assign to your project with Reader role, create client credentials.
INFISICAL_API_URL=http://10.x.x.x:8080
INFISICAL_PROJECT_ID=<project-id-from-infisical-ui>
INFISICAL_CLIENT_ID=<machine-identity-client-id>
INFISICAL_CLIENT_SECRET=<machine-identity-client-secret>

# === Connection ===
SIEM_SERVER_IP=10.x.x.x
SIEM_SERVER_HOST=yourserver.local
SIEM_SERVER_USER=yourusername

# === Secrets ===
# Grafana admin login password
GRAFANA_ADMIN_PASSWORD=changeme

# === SMTP — Google Workspace SMTP Relay (IP-based auth, no password needed) ===
# Used by: Grafana
# from_address must be a valid address in your Google Workspace domain
SMTP_HOST=smtp.yourdomain.com:587
SMTP_FROM=noreply@yourdomain.com
SMTP_STARTTLS_POLICY=MandatoryStartTLS

# Wazuh REST API password for the 'wazuh' admin user
# Requirements: min 1 uppercase, 1 lowercase, 1 digit, 1 symbol
WAZUH_API_PASSWORD=changeme

# Wazuh agent enrollment password
# Only needed if you enable password-based enrollment (authd.pass).
# Default setup uses open enrollment — leave unset unless you configure it.
# WAZUH_ENROLLMENT_PASSWORD=changeme

# === PostgreSQL ===
# PostgreSQL runs on siem_server — set to same IP as SIEM_SERVER_IP
POSTGRESQL_SERVER_IP=10.x.x.x
POSTGRESQL_SERVER_USER=yourusername

# PostgreSQL password for the infisical database user
# Requirements: min 16 chars, mix of letters and digits recommended
# Generate with: openssl rand -base64 16
POSTGRESQL_PASSWORD=changeme

# === Redis ===
# Redis runs natively on a separate node (RPi4) — immune to RPi5 jemalloc/16KB-page crash
REDIS_SERVER_IP=10.x.x.x
REDIS_SERVER_USER=yourusername

# Redis password (binds to 0.0.0.0 — reachable from siem_server over LAN)

# Requirements: min 32 chars; hex only — password is embedded in a redis:// URL,
# so base64 chars (/ =) break URL parsing
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=changeme

# === Infisical ===
# URL clients use to reach Infisical (must match actual LAN IP/hostname)
INFISICAL_SITE_URL=http://10.x.x.x:8080

# Infisical at-rest encryption key — must be exactly 32 characters
# Used directly as AES-256 key (32 bytes raw); do NOT use base64 or longer hex strings
# CRITICAL: never change this after first deploy; all stored secrets become unrecoverable
# Generate with: openssl rand -hex 16
INFISICAL_ENCRYPTION_KEY=changeme

# Infisical JWT signing secret — any long random string
# Requirements: min 32 chars
# Generate with: openssl rand -hex 32
INFISICAL_AUTH_SECRET=changeme

# === Unifi (Unpoller) ===
# Create a read-only local user in each Unifi controller for Unpoller.
# UnifiOS (UDM/Dream Machine): Settings → Admins → Add Admin → Role: Read Only
# Port is 443 for UDM/Dream Machine, 8443 for older CloudKey/software controller.

# Site 1 controller
UNIFI_CONTROLLER_URL_SITE1=https://10.x.x.x:443
UNIFI_USERNAME_SITE1=unpoller
UNIFI_PASSWORD_SITE1=changeme

# Site 2 controller
UNIFI_CONTROLLER_URL_SITE2=https://10.x.x.x:443
UNIFI_USERNAME_SITE2=unpoller
UNIFI_PASSWORD_SITE2=changeme

# === Cloudflare Tunnel (optional) ===
# Set GRAFANA_EXTERNAL_URL to the public URL Grafana embeds in alert notification links.
# Without this, alert links point to http://localhost:3000 (useless in notifications).
GRAFANA_EXTERNAL_URL=https://grafana.yourdomain.com

# Cloudflare Access team name — enables JWT auth so users log in via Cloudflare Access
# instead of Grafana's own login form. Find it at: one.dash.cloudflare.com → Access → Settings.
# Example: if your team domain is "myteam.cloudflareaccess.com", set this to "myteam".
# Omit to keep Grafana's built-in login.
CLOUDFLARE_TEAM_NAME=

# === Alerting (optional — omit to disable that channel) ===
# At least one must be set for silence alerts to notify.

# Email address to receive Grafana alerts (uses SMTP config above)
ALERT_EMAIL=you@yourdomain.com

# Discord incoming webhook URL
# Create at: Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_id/your_token

# === ntfy — crash alerts independent of Grafana ===
# Architecture: systemd OnFailure + Docker event notifier → ntfy
# Primary server: self-hosted ntfy on laf2 (LAN)
# Fallback: ntfy.sh free tier (cloud, always reachable)
# Active/passive: exactly 1 notification per event, no duplicates.

# ntfy topic name (used on primary self-hosted server)
NTFY_TOPIC=homelab

# ntfy access token for the self-hosted server on laf2
# Bootstrap (run once after deploying ntfy_server role):
#   ssh laf2 sudo ntfy user add --role=admin admin
#   ssh laf2 sudo ntfy token add --expires=0 admin
NTFY_TOKEN=

# ntfy.sh cloud fallback topic — use a random suffix for privacy
# (ntfy.sh topics are public; unpredictable name = only privacy layer)
# Example: homelab-f3k9xp2m  (generate: openssl rand -hex 4)
NTFY_CLOUD_TOPIC=homelab-
