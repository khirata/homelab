# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# === Connection ===
SIEM_SERVER_IP=10.x.x.x
SIEM_SERVER_HOST=yourserver.local
SIEM_SERVER_USER=yourusername

# === Secrets ===
# Grafana admin login password
GRAFANA_ADMIN_PASSWORD=changeme

# === SMTP — Google Workspace SMTP Relay (IP-based auth, no password needed) ===
# Used by: Grafana
# from_address must be a valid address in your Google Workspace domain
SMTP_HOST=smtp-relay.gmail.com:587
SMTP_FROM=noreply@yourdomain.com
SMTP_STARTTLS_POLICY=MandatoryStartTLS

# Wazuh REST API password for the 'wazuh' admin user
# Requirements: min 1 uppercase, 1 lowercase, 1 digit, 1 symbol
WAZUH_API_PASSWORD=changeme

# Wazuh agent enrollment password
# Only needed if you enable password-based enrollment (authd.pass).
# Default setup uses open enrollment — leave unset unless you configure it.
# WAZUH_ENROLLMENT_PASSWORD=changeme

# === PostgreSQL ===
# PostgreSQL runs on siem_server — set to same IP as SIEM_SERVER_IP
POSTGRESQL_SERVER_IP=10.x.x.x
POSTGRESQL_SERVER_USER=yourusername

# PostgreSQL password for the infisical database user
# Requirements: min 16 chars, mix of letters and digits recommended
# Generate with: openssl rand -base64 16
POSTGRESQL_PASSWORD=changeme

# === Redis ===
# Redis runs natively on a separate node (RPi4) — immune to RPi5 jemalloc/16KB-page crash
REDIS_SERVER_IP=10.x.x.x
REDIS_SERVER_USER=yourusername

# Redis password (binds to 0.0.0.0 — reachable from siem_server over LAN)

# Requirements: min 32 chars; hex only — password is embedded in a redis:// URL,
# so base64 chars (/ =) break URL parsing
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=changeme

# === Infisical ===
# URL clients use to reach Infisical (must match actual LAN IP/hostname)
INFISICAL_SITE_URL=http://10.x.x.x:8080

# Infisical at-rest encryption key — must be exactly 32 characters
# Used directly as AES-256 key (32 bytes raw); do NOT use base64 or longer hex strings
# CRITICAL: never change this after first deploy; all stored secrets become unrecoverable
# Generate with: openssl rand -hex 16
INFISICAL_ENCRYPTION_KEY=changeme

# Infisical JWT signing secret — any long random string
# Requirements: min 32 chars
# Generate with: openssl rand -hex 32
INFISICAL_AUTH_SECRET=changeme
