# Managed by Ansible — do not edit manually.
# Template: roles/syslog_relay/templates/syslog-relay.service.j2

[Unit]
Description=Relay UniFi syslog (UDP {{ syslog_relay_listen_port }}) to {{ syslog_relay_target }}
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
# One process, one datagram in → one datagram out, payload untouched.
# range= drops (and logs) any source outside syslog_relay_allowed_source. socat exits on a send
# error (e.g. Tailscale down); Restart= brings it back.
ExecStart=/usr/bin/socat -u -b 65536 UDP4-RECV:{{ syslog_relay_listen_port }},range={{ syslog_relay_allowed_source }} UDP4-SENDTO:{{ syslog_relay_target }}
Restart=always
RestartSec=5
# socat exits 143 on SIGTERM; a plain stop is not a failure.
SuccessExitStatus=143
SyslogIdentifier=syslog-relay

DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
