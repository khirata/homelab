# Managed by Ansible — do not edit manually.
# Template: roles/infisical/templates/infisical.env.j2
# Mode 0600 — contains secrets.

NODE_ENV=production
PORT=8080
# SITE_URL governs OAuth redirect URIs and email links.
# Use the public CF Tunnel URL when Infisical is exposed externally; otherwise the LAN URL.
SITE_URL={{ infisical_external_url | default(infisical_site_url, true) }}

DB_CONNECTION_URI=postgresql://{{ infisical_db_user }}:{{ vault_postgresql_password }}@host.docker.internal:5432/{{ infisical_db_name }}
REDIS_URL=redis://:{{ vault_redis_password }}@{{ redis_server_ip }}:{{ redis_port }}

# CRITICAL: ENCRYPTION_KEY must never change after first deploy.
# Changing it makes all stored secrets unrecoverable.
ENCRYPTION_KEY={{ vault_infisical_encryption_key }}
AUTH_SECRET={{ vault_infisical_auth_secret }}

{% if vault_infisical_client_id_google %}
# Google OAuth — enables "Sign in with Google" (same identity as Cloudflare Access).
# Create credentials at: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI: {{ infisical_external_url | default(infisical_site_url, true) }}/api/v1/sso/google
CLIENT_ID_GOOGLE_LOGIN={{ vault_infisical_client_id_google }}
CLIENT_SECRET_GOOGLE_LOGIN={{ vault_infisical_client_secret_google }}
{% endif %}
