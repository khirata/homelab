# Managed by Ansible — do not edit manually.
# Template: roles/infisical/templates/infisical.env.j2
# Mode 0600 — contains secrets.

NODE_ENV=production
PORT=8080
SITE_URL={{ infisical_site_url }}

DB_CONNECTION_URI=postgresql://{{ infisical_db_user }}:{{ vault_infisical_db_password }}@host.docker.internal:5432/{{ infisical_db_name }}
REDIS_URL=redis://host.docker.internal:{{ redis_port }}

# CRITICAL: ENCRYPTION_KEY must never change after first deploy.
# Changing it makes all stored secrets unrecoverable.
ENCRYPTION_KEY={{ vault_infisical_encryption_key }}
AUTH_SECRET={{ vault_infisical_auth_secret }}
