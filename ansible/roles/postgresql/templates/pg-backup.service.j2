# Managed by Ansible — do not edit manually.
# Template: roles/postgresql/templates/pg-backup.service.j2

[Unit]
Description=PostgreSQL backup — {{ infisical_db_name }}
After=postgresql@{{ postgresql_version }}-main.service
Requires=postgresql@{{ postgresql_version }}-main.service

[Service]
Type=oneshot
User=postgres
ExecStart=/usr/local/bin/pg-backup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pg-backup
