#!/usr/bin/env bash
# Managed by Ansible — do not edit manually.
set -euo pipefail

DEST="{{ pg_backup_dir }}/$(date +%Y%m%d_%H%M%S)_{{ infisical_db_name }}.pgdump"

echo "Starting backup: ${DEST}"
# No -U flag: this runs as OS user postgres (see pg-backup.service User=), which
# connects over the local socket via peer auth as the matching "postgres" role.
# Passing -U {{ infisical_db_user }} here fails peer auth (OS user != db role) —
# the postgres role can already read every database, so no app credential is needed.
pg_dump -Fc "{{ infisical_db_name }}" -f "${DEST}"
echo "Backup complete: ${DEST}"

# Prune backups older than {{ pg_backup_retain_days }} days
find "{{ pg_backup_dir }}" -name '*.pgdump' -mtime +{{ pg_backup_retain_days }} -delete
echo "Pruned backups older than {{ pg_backup_retain_days }} days"

{% if pg_backup_offsite_enabled %}
echo "Syncing to offsite: {{ pg_backup_rclone_remote }}:{{ pg_backup_rclone_bucket }}"
rclone copy "{{ pg_backup_dir }}" "{{ pg_backup_rclone_remote }}:{{ pg_backup_rclone_bucket }}"
echo "Offsite sync complete"
{% endif %}
