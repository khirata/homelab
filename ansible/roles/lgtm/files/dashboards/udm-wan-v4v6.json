    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "sum by (family, direction)(rate(udm_wan_bytes_total[5m])) * 8. IPv4 is derived (WAN total − IPv6) and includes the L2 overhead of all traffic (~1%).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "bps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* tx$"
            },
            "properties": [
              {
                "id": "custom.transform",
                "value": "negative-Y"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (family, direction) (rate(udm_wan_bytes_total{site=~\"$site\"}[5m])) * 8",
          "legendFormat": "{{family}} {{direction}}",
          "refId": "A"
        }
      ],
      "title": "WAN bandwidth by IP family (rx ↑ / tx ↓)",
