  },
  "description": "WireGuard tunnel health between Lafayette and Sakamoto. wgclt1 carries policy-routed devices (e.g. the TV) out via Sakamoto; when it is released from WAN those devices silently fall back to the local Lafayette WAN. Tunnel state is invisible in log volume, so this tracks state transitions.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "releases minus controls per tunnel. >0 means a tunnel is still detached from WAN and policy-routed devices are leaking to the local WAN.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "(sum by (site, iface) (count_over_time({job=\"unifi\"} |~ `wf-interfaces-container releases 'wg` | regexp `releases '(?P<iface>[^']+)'` [$__range]))) - ((sum by (site, iface) (count_over_time({job=\"unifi\"} |~ `wf-interfaces-container controls 'wg` | regexp `controls '(?P<iface>[^']+)'` [$__range]))) or ((sum by (site, iface) (count_over_time({job=\"unifi\"} |~ `wf-interfaces-container releases 'wg` | regexp `releases '(?P<iface>[^']+)'` [$__range]))) * 0))",
          "instant": true,
          "legendFormat": "{{site}} {{iface}}",
          "refId": "A"
        }
      ],
      "title": "Tunnels released from WAN (not recovered)",
      "type": "stat"
    },
