# Managed by Ansible — do not edit manually.
# Template: roles/lgtm/templates/grafana-alerting-contact-points.yaml.j2
# Channels are enabled only when the corresponding env var is set.

apiVersion: 1

contactPoints:
  - orgId: 1
    name: homelab-alerts
    receivers:
{% if alert_email %}
      - uid: receiver-email
        type: email
        settings:
          addresses: "{{ alert_email }}"
          singleEmail: false
{% endif %}
{% if discord_webhook_url %}
      - uid: receiver-discord
        type: discord
        settings:
          url: "{{ discord_webhook_url }}"
          use_discord_username: false
{% endif %}
{% if ntfy_token %}

  # Opt-in per rule: only alerts labelled notify=ntfy reach it (see
  # notification-policy.yaml). ntfy's built-in "grafana" template turns the
  # webhook JSON into a readable title and body. Primary ntfy only — Grafana
  # cannot fail over, and adding the ntfy.sh topic too would double every push.
  - orgId: 1
    name: homelab-ntfy
    receivers:
      - uid: receiver-ntfy
        type: webhook
        settings:
          url: "http://{{ ntfy_server_ip }}:{{ ntfy_port }}/{{ ntfy_topic }}?template=grafana"
          httpMethod: POST
          authorization_scheme: Bearer
          authorization_credentials: "{{ ntfy_token }}"
{% endif %}
