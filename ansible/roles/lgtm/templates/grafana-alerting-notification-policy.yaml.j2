# Managed by Ansible — do not edit manually.
# Template: roles/lgtm/templates/grafana-alerting-notification-policy.yaml.j2

apiVersion: 1

policies:
  - orgId: 1
    receiver: homelab-alerts
    group_by:
      - grafana_folder
      - alertname
    group_wait: 30s
    group_interval: 5m
    repeat_interval: 4h
{% if ntfy_token %}
    # notify=ntfy adds ntfy on top of the default channels. A matched child
    # route replaces the root receiver, so the second route re-adds
    # homelab-alerts; continue lets the first match fall through to it.
    # Grouped per site/container too, so each broken site is its own push.
    routes:
      - receiver: homelab-ntfy
        object_matchers:
          - ["notify", "=", "ntfy"]
        group_by: [grafana_folder, alertname, site, container_name]
        continue: true
      - receiver: homelab-alerts
        object_matchers:
          - ["notify", "=", "ntfy"]
        group_by: [grafana_folder, alertname, site, container_name]
{% endif %}
