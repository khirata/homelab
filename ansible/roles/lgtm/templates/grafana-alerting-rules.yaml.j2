# Managed by Ansible — do not edit manually.
# Template: roles/lgtm/templates/grafana-alerting-rules.yaml.j2

apiVersion: 1

groups:
  - orgId: 1
    name: alloy-watchdog
    folder: Homelab
    interval: 2m
    rules:

      # Fires when a node stops sending Prometheus metrics for >5 min.
      # Covers: Alloy fully crashed, node unreachable, network partition, and
      # Alloy running fine but remote-writing to an address that no longer
      # answers (how laf2 went dark on 2026-08-02).
      #
      # The "expected hosts" set comes from a 7d lookback, not 1h. With 1h the
      # rule healed itself: once a host had been silent for over an hour it
      # dropped out of the left-hand side too, `unless` yielded nothing, and
      # noDataState=OK resolved the alert. A dead node alerted for ~55 min and
      # was then silent forever — laf2 sat unnoticed for a week that way.
      # 7d is within the 30d TSDB retention, so a departed host keeps alerting
      # for a week. Decommissioning a node now means silencing this for 7d, or
      # deleting its series; that is the intended trade.
      #
      # Keyed on node_uname_info (one series per host) rather than
      # node_cpu_seconds_total (cpu x mode per host) — same signal, and the 7d
      # range stays cheap to evaluate every 2m.
      - uid: node-metrics-silence
        title: "Node metrics silence"
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 600
              to: 0
            model:
              expr: 'count by (instance) (last_over_time(node_uname_info{job="node"}[7d])) unless count by (instance) (last_over_time(node_uname_info{job="node"}[5m]))'
              instant: true
          - refId: B
            datasourceUid: "__expr__"
            model:
              type: reduce
              expression: "A"
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            datasourceUid: "__expr__"
            model:
              type: threshold
              expression: "B"
              conditions:
                - evaluator: { type: gt, params: [0] }
        noDataState: OK
        execErrState: Alerting
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "No metrics from {{ '{{' }} $labels.instance {{ '}}' }} for 5+ min"
          description: "Alloy may have crashed or the node is unreachable."

      # Fires when a node stops sending journal logs to Loki for >5 min.
      # noDataState=Alerting: if an instance disappears entirely Loki returns
      # no data (not 0), so absence must also fire.
      - uid: node-log-silence
        title: "Node log silence"
        condition: C
        data:
          - refId: A
            datasourceUid: loki
            relativeTimeRange:
              from: 600
              to: 0
            model:
              expr: 'sum by (instance) (count_over_time({job="journal"}[5m]))'
              instant: true
          - refId: B
            datasourceUid: "__expr__"
            model:
              type: reduce
              expression: "A"
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            datasourceUid: "__expr__"
            model:
              type: threshold
              expression: "B"
              conditions:
                - evaluator: { type: lt, params: [1] }
        noDataState: Alerting
        execErrState: Alerting
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "No logs from {{ '{{' }} $labels.instance {{ '}}' }} for 5+ min"
          description: "Alloy journal pipeline may have stopped."

      # PostgreSQL log silence — file logs via job="postgresql".
      # An idle instance writes no WAL, skips checkpoints, and can log nothing
      # for days, so organic logs cannot feed this alert. pg-log-heartbeat.timer
      # (postgresql role) emits one LOG line every 5 min, making this rule an
      # end-to-end check of postgres → log file → Alloy → Loki.
      # 10 min = 2 missed heartbeats before firing.
      - uid: postgresql-log-silence
        title: "PostgreSQL log silence"
        condition: C
        data:
          - refId: A
            datasourceUid: loki
            relativeTimeRange:
              from: 900
              to: 0
            model:
              expr: 'sum by (instance) (count_over_time({job="postgresql"}[10m]))'
              instant: true
          - refId: B
            datasourceUid: "__expr__"
            model:
              type: reduce
              expression: "A"
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            datasourceUid: "__expr__"
            model:
              type: threshold
              expression: "B"
              conditions:
                - evaluator: { type: lt, params: [1] }
        noDataState: Alerting
        execErrState: Alerting
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "No PostgreSQL logs from {{ '{{' }} $labels.instance {{ '}}' }} for 10+ min"
          description: "PostgreSQL log file pipeline may have stopped."

      # Redis log silence — journal logs via service_name="redis-server".
      # Observed: exactly 5 log lines per 5-min RDB save cycle, zero gaps over 24h.
      # 10 min = 2 missed save cycles before firing.
      - uid: redis-log-silence
        title: "Redis log silence"
        condition: C
        data:
          - refId: A
            datasourceUid: loki
            relativeTimeRange:
              from: 900
              to: 0
            model:
              expr: 'sum by (instance) (count_over_time({job="journal",service_name="redis-server"}[10m]))'
              instant: true
          - refId: B
            datasourceUid: "__expr__"
            model:
              type: reduce
              expression: "A"
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            datasourceUid: "__expr__"
            model:
              type: threshold
              expression: "B"
              conditions:
                - evaluator: { type: lt, params: [1] }
        noDataState: Alerting
        execErrState: Alerting
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "No Redis logs from {{ '{{' }} $labels.instance {{ '}}' }} for 10+ min"
          description: "Redis may be down or its journal log pipeline has stopped."

      # UniFi GW syslog silence — per site.
      # Observed: 24–189 syslog messages per 5-min bucket (avg 79), zero gaps.
      # 5 min silence means GW is unreachable or SIEM syslog listener is broken.
      # No Prometheus metrics for UniFi — log-only detection.
      - uid: unifi-syslog-silence
        title: "UniFi syslog silence"
        condition: C
        data:
          - refId: A
            datasourceUid: loki
            relativeTimeRange:
              from: 600
              to: 0
            model:
              expr: 'sum by (site) (count_over_time({job="unifi"}[5m]))'
              instant: true
          - refId: B
            datasourceUid: "__expr__"
            model:
              type: reduce
              expression: "A"
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            datasourceUid: "__expr__"
            model:
              type: threshold
              expression: "B"
              conditions:
                - evaluator: { type: lt, params: [1] }
        noDataState: Alerting
        execErrState: Alerting
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "No UniFi syslog from site {{ '{{' }} $labels.site {{ '}}' }} for 5+ min"
          description: "UniFi GW may be unreachable or SIEM syslog listener is broken."

  # Unpoller — one container per site (unpoller_sites). Every rule groups by
  # site or container, never by a site name, so a site added to unpoller_sites
  # is watched with no change here. notify=ntfy routes these to ntfy as well
  # as the default channels (notification-policy.yaml).
  #
  # The three cover different breaks:
  #   fetch-failing  unpoller can't read its controller (timeout, 401) — logs
  #   scrape-down    Prometheus can't scrape unpoller (container gone, or the
  #                  poll failed so unpoller answered the scrape with an error)
  #   data-missing   a registered site has no device metrics for 15 min,
  #                  whatever the cause — the backstop for the other two
  #
  # Baseline, measured before the split: a controller occasionally fails one
  # poll (401 on session expiry, a truncated JSON reply) roughly 30x/day across
  # both sites, each recovering on the next poll. The thresholds below ignore a
  # lone failure and fire only when a site stays broken.
  - orgId: 1
    name: unpoller-watchdog
    folder: Homelab
    interval: 1m
    rules:

      # Threshold from the 2026-10 outages, not from the poll interval. With
      # the controller unreachable each poll hangs on TCP connect for ~135s
      # (unpoller v2.11 has no request timeout) and polls run one at a time,
      # so a dead site logs only 4-5 failures per 10 min — never fewer than 4
      # across the 10-05 outage. Healthy, a site's worst 10 min was 3: a burst
      # of 401s within 2s on session expiry. >3 sits between the two.
      # noDataState=OK: no failure lines is the healthy state. A stopped
      # container also logs nothing — unpoller-scrape-down covers that.
      - uid: unpoller-fetch-failing
        title: "Unpoller fetch failing"
        condition: C
        data:
          - refId: A
            datasourceUid: loki
            relativeTimeRange:
              from: 900
              to: 0
            model:
              expr: 'sum by (container_name) (count_over_time({job="docker", container_name=~"unpoller-.+"} |= "metric fetch failed" [10m]))'
              instant: true
          - refId: B
            datasourceUid: "__expr__"
            model:
              type: reduce
              expression: "A"
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            datasourceUid: "__expr__"
            model:
              type: threshold
              expression: "B"
              conditions:
                - evaluator: { type: gt, params: [3] }
        noDataState: OK
        execErrState: Alerting
        for: 5m
        labels:
          severity: warning
          notify: ntfy
        annotations:
          summary: "{{ '{{' }} $labels.container_name {{ '}}' }} cannot fetch from its UniFi controller for 5+ min"
          description: "unpoller logs 'metric fetch failed' on most polls — controller unreachable or its read-only user rejected. See docker logs."

      # up is 0 when a scrape fails outright. unpoller turns a failed poll into
      # a failed scrape, so this fires for a dead controller as well as for a
      # dead container. noDataState=Alerting: no up series at all means no
      # unpoller target is registered, i.e. file_sd is broken.
      - uid: unpoller-scrape-down
        title: "Unpoller scrape down"
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 600
              to: 0
            model:
              expr: 'up{job="unpoller"}'
              instant: true
          - refId: B
            datasourceUid: "__expr__"
            model:
              type: reduce
              expression: "A"
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            datasourceUid: "__expr__"
            model:
              type: threshold
              expression: "B"
              conditions:
                - evaluator: { type: lt, params: [1] }
        noDataState: Alerting
        execErrState: Alerting
        for: 5m
        labels:
          severity: warning
          notify: ntfy
        annotations:
          summary: "Prometheus cannot scrape unpoller for site {{ '{{' }} $labels.site {{ '}}' }} for 5+ min"
          description: "Target {{ '{{' }} $labels.instance {{ '}}' }} is down. Either the container is not running or every poll of its controller fails."

      # Every site with a registered target (any up value) that has had no
      # unifi_device_uptime_seconds sample in 5 min. Present for every adopted
      # device, so a healthy site always has it. last_over_time skips the
      # staleness markers a single failed scrape leaves, so one bad poll does
      # not open a gap. Fires alongside scrape-down for a dead controller, and
      # alone for a poll that "succeeds" with no devices (e.g. a user that can
      # log in but sees no site).
      - uid: unpoller-data-missing
        title: "Unpoller site data missing"
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 600
              to: 0
            model:
              expr: 'group by (site) (up{job="unpoller"}) unless on (site) group by (site) (last_over_time(unifi_device_uptime_seconds{job="unpoller"}[5m]))'
              instant: true
          - refId: B
            datasourceUid: "__expr__"
            model:
              type: reduce
              expression: "A"
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            datasourceUid: "__expr__"
            model:
              type: threshold
              expression: "B"
              conditions:
                - evaluator: { type: gt, params: [0] }
        noDataState: OK
        execErrState: Alerting
        for: 15m
        labels:
          severity: warning
          notify: ntfy
        annotations:
          summary: "No UniFi device metrics from site {{ '{{' }} $labels.site {{ '}}' }} for 15+ min"
          description: "Target is registered but unifi_device_uptime_seconds stopped. Check the other unpoller-watchdog alerts."

# Grafana's alerting provisioning is upsert-only: dropping a rule from `groups`
# above leaves the previously provisioned rule live in Grafana's database, so it
# keeps evaluating and paging. Withdrawing a rule therefore takes two steps —
# remove it from `groups` AND name its uid here.
#
# Keep these entries. They are idempotent once the rules are gone, and removing
# them would not resurrect anything, but leaving them documents what was
# withdrawn. If any of these uids is ever reinstated in `groups`, delete its
# entry here first or provisioning will remove the rule again.
deleteRules:
  - orgId: 1
    uid: vpn-wan-tunnel-released
  - orgId: 1
    uid: vpn-peer-lost
  - orgId: 1
    uid: vpn-peer-flapping
