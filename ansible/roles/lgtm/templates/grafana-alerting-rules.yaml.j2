# Managed by Ansible — do not edit manually.
# Template: roles/lgtm/templates/grafana-alerting-rules.yaml.j2

apiVersion: 1

groups:
  - orgId: 1
    name: alloy-watchdog
    folder: Homelab
    interval: 2m
    rules:

      # Fires when a node stops sending Prometheus metrics for >5 min.
      # Covers: Alloy fully crashed, node unreachable, network partition, and
      # Alloy running fine but remote-writing to an address that no longer
      # answers (how laf2 went dark on 2026-08-02).
      #
      # The "expected hosts" set comes from a 7d lookback, not 1h. With 1h the
      # rule healed itself: once a host had been silent for over an hour it
      # dropped out of the left-hand side too, `unless` yielded nothing, and
      # noDataState=OK resolved the alert. A dead node alerted for ~55 min and
      # was then silent forever — laf2 sat unnoticed for a week that way.
      # 7d is within the 30d TSDB retention, so a departed host keeps alerting
      # for a week. Decommissioning a node now means silencing this for 7d, or
      # deleting its series; that is the intended trade.
      #
      # Keyed on node_uname_info (one series per host) rather than
      # node_cpu_seconds_total (cpu x mode per host) — same signal, and the 7d
      # range stays cheap to evaluate every 2m.
      - uid: node-metrics-silence
        title: "Node metrics silence"
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 600
              to: 0
            model:
              expr: 'count by (instance) (last_over_time(node_uname_info{job="node"}[7d])) unless count by (instance) (last_over_time(node_uname_info{job="node"}[5m]))'
              instant: true
          - refId: B
            datasourceUid: "__expr__"
            model:
              type: reduce
              expression: "A"
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            datasourceUid: "__expr__"
            model:
              type: threshold
              expression: "B"
              conditions:
                - evaluator: { type: gt, params: [0] }
        noDataState: OK
        execErrState: Alerting
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "No metrics from {{ '{{' }} $labels.instance {{ '}}' }} for 5+ min"
          description: "Alloy may have crashed or the node is unreachable."

      # Fires when a node stops sending journal logs to Loki for >5 min.
      # noDataState=Alerting: if an instance disappears entirely Loki returns
      # no data (not 0), so absence must also fire.
      - uid: node-log-silence
        title: "Node log silence"
        condition: C
        data:
          - refId: A
            datasourceUid: loki
            relativeTimeRange:
              from: 600
              to: 0
            model:
              expr: 'sum by (instance) (count_over_time({job="journal"}[5m]))'
              instant: true
          - refId: B
            datasourceUid: "__expr__"
            model:
              type: reduce
              expression: "A"
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            datasourceUid: "__expr__"
            model:
              type: threshold
              expression: "B"
              conditions:
                - evaluator: { type: lt, params: [1] }
        noDataState: Alerting
        execErrState: Alerting
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "No logs from {{ '{{' }} $labels.instance {{ '}}' }} for 5+ min"
          description: "Alloy journal pipeline may have stopped."

      # PostgreSQL log silence — file logs via job="postgresql".
      # An idle instance writes no WAL, skips checkpoints, and can log nothing
      # for days, so organic logs cannot feed this alert. pg-log-heartbeat.timer
      # (postgresql role) emits one LOG line every 5 min, making this rule an
      # end-to-end check of postgres → log file → Alloy → Loki.
      # 10 min = 2 missed heartbeats before firing.
      - uid: postgresql-log-silence
        title: "PostgreSQL log silence"
        condition: C
        data:
          - refId: A
            datasourceUid: loki
            relativeTimeRange:
              from: 900
              to: 0
            model:
              expr: 'sum by (instance) (count_over_time({job="postgresql"}[10m]))'
              instant: true
          - refId: B
            datasourceUid: "__expr__"
            model:
              type: reduce
              expression: "A"
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            datasourceUid: "__expr__"
            model:
              type: threshold
              expression: "B"
              conditions:
                - evaluator: { type: lt, params: [1] }
        noDataState: Alerting
        execErrState: Alerting
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "No PostgreSQL logs from {{ '{{' }} $labels.instance {{ '}}' }} for 10+ min"
          description: "PostgreSQL log file pipeline may have stopped."

      # Redis log silence — journal logs via service_name="redis-server".
      # Observed: exactly 5 log lines per 5-min RDB save cycle, zero gaps over 24h.
      # 10 min = 2 missed save cycles before firing.
      - uid: redis-log-silence
        title: "Redis log silence"
        condition: C
        data:
          - refId: A
            datasourceUid: loki
            relativeTimeRange:
              from: 900
              to: 0
            model:
              expr: 'sum by (instance) (count_over_time({job="journal",service_name="redis-server"}[10m]))'
              instant: true
          - refId: B
            datasourceUid: "__expr__"
            model:
              type: reduce
              expression: "A"
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            datasourceUid: "__expr__"
            model:
              type: threshold
              expression: "B"
              conditions:
                - evaluator: { type: lt, params: [1] }
        noDataState: Alerting
        execErrState: Alerting
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "No Redis logs from {{ '{{' }} $labels.instance {{ '}}' }} for 10+ min"
          description: "Redis may be down or its journal log pipeline has stopped."

      # UniFi GW syslog silence — per site.
      # Observed: 24–189 syslog messages per 5-min bucket (avg 79), zero gaps.
      # 5 min silence means GW is unreachable or SIEM syslog listener is broken.
      # No Prometheus metrics for UniFi — log-only detection.
      - uid: unifi-syslog-silence
        title: "UniFi syslog silence"
        condition: C
        data:
          - refId: A
            datasourceUid: loki
            relativeTimeRange:
              from: 600
              to: 0
            model:
              expr: 'sum by (site) (count_over_time({job="unifi"}[5m]))'
              instant: true
          - refId: B
            datasourceUid: "__expr__"
            model:
              type: reduce
              expression: "A"
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            datasourceUid: "__expr__"
            model:
              type: threshold
              expression: "B"
              conditions:
                - evaluator: { type: lt, params: [1] }
        noDataState: Alerting
        execErrState: Alerting
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "No UniFi syslog from site {{ '{{' }} $labels.site {{ '}}' }} for 5+ min"
          description: "UniFi GW may be unreachable or SIEM syslog listener is broken."

# Grafana's alerting provisioning is upsert-only: dropping a rule from `groups`
# above leaves the previously provisioned rule live in Grafana's database, so it
# keeps evaluating and paging. Withdrawing a rule therefore takes two steps —
# remove it from `groups` AND name its uid here.
#
# Keep these entries. They are idempotent once the rules are gone, and removing
# them would not resurrect anything, but leaving them documents what was
# withdrawn. If any of these uids is ever reinstated in `groups`, delete its
# entry here first or provisioning will remove the rule again.
deleteRules:
  - orgId: 1
    uid: vpn-wan-tunnel-released
  - orgId: 1
    uid: vpn-peer-lost
  - orgId: 1
    uid: vpn-peer-flapping
