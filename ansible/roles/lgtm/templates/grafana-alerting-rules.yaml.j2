# Managed by Ansible — do not edit manually.
# Template: roles/lgtm/templates/grafana-alerting-rules.yaml.j2

apiVersion: 1

groups:
  - orgId: 1
    name: alloy-watchdog
    folder: Homelab
    interval: 2m
    rules:

      # Fires when a node stops sending Prometheus metrics for >5 min.
      # Covers: Alloy fully crashed, node unreachable, network partition.
      - uid: node-metrics-silence
        title: "Node metrics silence"
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 600
              to: 0
            model:
              expr: 'count by (instance) (last_over_time(node_cpu_seconds_total{job="node"}[1h])) unless count by (instance) (last_over_time(node_cpu_seconds_total{job="node"}[5m]))'
              instant: true
          - refId: B
            datasourceUid: "__expr__"
            model:
              type: reduce
              expression: "A"
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            datasourceUid: "__expr__"
            model:
              type: threshold
              expression: "B"
              conditions:
                - evaluator: { type: gt, params: [0] }
        noDataState: OK
        execErrState: Alerting
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "No metrics from {{ '{{' }} $labels.instance {{ '}}' }} for 5+ min"
          description: "Alloy may have crashed or the node is unreachable."

      # Fires when a node stops sending journal logs to Loki for >5 min.
      # noDataState=Alerting: if an instance disappears entirely Loki returns
      # no data (not 0), so absence must also fire.
      - uid: node-log-silence
        title: "Node log silence"
        condition: C
        data:
          - refId: A
            datasourceUid: loki
            relativeTimeRange:
              from: 600
              to: 0
            model:
              expr: 'sum by (instance) (count_over_time({job="journal"}[5m]))'
              instant: true
          - refId: B
            datasourceUid: "__expr__"
            model:
              type: reduce
              expression: "A"
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            datasourceUid: "__expr__"
            model:
              type: threshold
              expression: "B"
              conditions:
                - evaluator: { type: lt, params: [1] }
        noDataState: Alerting
        execErrState: Alerting
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "No logs from {{ '{{' }} $labels.instance {{ '}}' }} for 5+ min"
          description: "Alloy journal pipeline may have stopped."

      # PostgreSQL log silence — file logs via job="postgresql".
      # Observed: 2–5 log lines per 5-min bucket, zero gaps over 24h.
      # 10 min = 2 missed cycles before firing.
      - uid: postgresql-log-silence
        title: "PostgreSQL log silence"
        condition: C
        data:
          - refId: A
            datasourceUid: loki
            relativeTimeRange:
              from: 900
              to: 0
            model:
              expr: 'sum by (instance) (count_over_time({job="postgresql"}[10m]))'
              instant: true
          - refId: B
            datasourceUid: "__expr__"
            model:
              type: reduce
              expression: "A"
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            datasourceUid: "__expr__"
            model:
              type: threshold
              expression: "B"
              conditions:
                - evaluator: { type: lt, params: [1] }
        noDataState: Alerting
        execErrState: Alerting
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "No PostgreSQL logs from {{ '{{' }} $labels.instance {{ '}}' }} for 10+ min"
          description: "PostgreSQL log file pipeline may have stopped."

      # Redis log silence — journal logs via service_name="redis-server".
      # Observed: exactly 5 log lines per 5-min RDB save cycle, zero gaps over 24h.
      # 10 min = 2 missed save cycles before firing.
      - uid: redis-log-silence
        title: "Redis log silence"
        condition: C
        data:
          - refId: A
            datasourceUid: loki
            relativeTimeRange:
              from: 900
              to: 0
            model:
              expr: 'sum by (instance) (count_over_time({job="journal",service_name="redis-server"}[10m]))'
              instant: true
          - refId: B
            datasourceUid: "__expr__"
            model:
              type: reduce
              expression: "A"
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            datasourceUid: "__expr__"
            model:
              type: threshold
              expression: "B"
              conditions:
                - evaluator: { type: lt, params: [1] }
        noDataState: Alerting
        execErrState: Alerting
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "No Redis logs from {{ '{{' }} $labels.instance {{ '}}' }} for 10+ min"
          description: "Redis may be down or its journal log pipeline has stopped."

      # UniFi GW syslog silence — per site.
      # Observed: 24–189 syslog messages per 5-min bucket (avg 79), zero gaps.
      # 5 min silence means GW is unreachable or SIEM syslog listener is broken.
      # No Prometheus metrics for UniFi — log-only detection.
      - uid: unifi-syslog-silence
        title: "UniFi syslog silence"
        condition: C
        data:
          - refId: A
            datasourceUid: loki
            relativeTimeRange:
              from: 600
              to: 0
            model:
              expr: 'sum by (site) (count_over_time({job="unifi"}[5m]))'
              instant: true
          - refId: B
            datasourceUid: "__expr__"
            model:
              type: reduce
              expression: "A"
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            datasourceUid: "__expr__"
            model:
              type: threshold
              expression: "B"
              conditions:
                - evaluator: { type: lt, params: [1] }
        noDataState: Alerting
        execErrState: Alerting
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "No UniFi syslog from site {{ '{{' }} $labels.site {{ '}}' }} for 5+ min"
          description: "UniFi GW may be unreachable or SIEM syslog listener is broken."

  # VPN watchdog — WireGuard tunnels between Lafayette and Sakamoto.
  #
  #   wgclt1     Lafayette -> Sakamoto WireGuard client tunnel. Devices with a
  #              policy route to Sakamoto (e.g. the TV) egress through this.
  #   wgsts1000  UniFi "Magic Site-to-Site" WireGuard tunnel.
  #   wgsrv1     WireGuard server on each GW for roaming clients (laptops/phones).
  #
  # Derived from the 2026-07-27 21:44 incident. The far end re-established on a
  # new UDP source port and every tunnel dropped. wgsts1000 and wgsrv1 recovered
  # on their own within ~90s; wgclt1 did not — it was released as a WAN interface
  # and stayed down for 47h until it was restarted manually on 07-29 20:24.
  #
  # The failure mode is a SILENT LEAK, not an outage: when wgclt1 is released,
  # policy-routed devices fall back to the local Lafayette WAN and keep working,
  # just via the wrong exit. Nothing goes down, so neither unifi-syslog-silence
  # nor any volume-based rule can see it.
  #
  # These rules deliberately do NOT key off tunnel create/delete/reconfigure
  # events: those are emitted by the manual restart that FIXES the problem, so
  # they would only ever fire after the outage was already over.
  - orgId: 1
    name: vpn-watchdog
    folder: Homelab
    interval: 2m
    rules:

      # THE rule. wanFailover emits a matched pair per tunnel:
      #   "wf-interfaces-container releases 'X' as a WAN interface"  -> down
      #   "wf-interfaces-container controls 'X' as a WAN interface"  -> up
      # A healthy blip pairs them within ~90s, so releases-minus-controls
      # settles back to 0. A tunnel that never comes back stays at >0.
      #
      # `(B or (A * 0))` fills a zero for tunnels that were released but never
      # controlled in the window. Without it the subtraction is an inner join and
      # silently drops exactly the series we need — the stuck tunnel.
      #
      # The window is 7d, not 24h, on purpose. Because this is a count
      # difference rather than a presence test, a release that was properly
      # paired with a control nets to 0 no matter how long the window is — but
      # too SHORT a window lets the release age out while the tunnel is still
      # broken, and the alert goes quiet mid-outage. Measured against the real
      # 47h outage: 24h stopped firing after 07-28 21:44 while wgclt1 was still
      # down; 7d kept firing until it was actually fixed. Costs ~1.1s/eval.
      - uid: vpn-wan-tunnel-released
        title: "VPN tunnel released from WAN (policy routes leaking)"
        condition: C
        data:
          - refId: A
            datasourceUid: loki
            relativeTimeRange:
              from: 604800
              to: 0
            model:
              expr: >-
                (sum by (site, iface) (count_over_time({job="unifi"}
                |~ `wf-interfaces-container releases 'wg`
                | regexp `releases '(?P<iface>[^']+)'` [7d])))
                -
                ((sum by (site, iface) (count_over_time({job="unifi"}
                |~ `wf-interfaces-container controls 'wg`
                | regexp `controls '(?P<iface>[^']+)'` [7d])))
                or
                ((sum by (site, iface) (count_over_time({job="unifi"}
                |~ `wf-interfaces-container releases 'wg`
                | regexp `releases '(?P<iface>[^']+)'` [7d]))) * 0))
              instant: true
          - refId: B
            datasourceUid: "__expr__"
            model:
              type: reduce
              expression: "A"
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            datasourceUid: "__expr__"
            model:
              type: threshold
              expression: "B"
              conditions:
                - evaluator: { type: gt, params: [0] }
        noDataState: OK
        execErrState: Alerting
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Tunnel {{ '{{' }} $labels.iface {{ '}}' }} at {{ '{{' }} $labels.site {{ '}}' }} is released from WAN and has not recovered"
          description: >-
            Over the last 7 days this tunnel was released as a WAN interface with
            no matching "controls" event following it, so it is still detached.
            Devices policy-routed over it are silently falling back to the local
            WAN — still online, but egressing from the wrong site, which is why
            nothing looks "down". Re-resolve the peer endpoint by toggling the
            tunnel on the gateway.

      # Peer churn. Normal is 3–10 connect events/day per site; 10 connect or
      # disconnect events inside 15 min means something is flapping.
      - uid: vpn-peer-flapping
        title: "VPN peer flapping"
        condition: C
        data:
          - refId: A
            datasourceUid: loki
            relativeTimeRange:
              from: 1200
              to: 0
            model:
              expr: 'sum by (site) (count_over_time({job="unifi"} |~ `EVT_VPN_Client(Connected|Disconnected)` [15m]))'
              instant: true
          - refId: B
            datasourceUid: "__expr__"
            model:
              type: reduce
              expression: "A"
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            datasourceUid: "__expr__"
            model:
              type: threshold
              expression: "B"
              conditions:
                - evaluator: { type: gt, params: [10] }
        noDataState: OK
        execErrState: Alerting
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "VPN peers flapping at site {{ '{{' }} $labels.site {{ '}}' }}"
          description: "More than 10 VPN connect/disconnect events in 15 min. Check WAN stability or a roaming client stuck in a reconnect loop."

      # WireGuard peer went away and did not come back. Complements
      # vpn-wan-tunnel-released: that rule watches the wanFailover attachment,
      # this one watches the peer session itself, so a tunnel that loses its peer
      # without being released from WAN is still caught.
      # ') disconnected' / ') connected' are anchored on the closing paren
      # because a bare `connected` also matches inside `disconnected`.
      #
      # Scoped to wgclt*/wgsts* (the always-on inter-site tunnels) and NOT
      # wgsrv* — roaming laptops and phones legitimately connect and disconnect
      # all day, so including the server tunnels would let normal churn drift
      # the difference positive and fire spuriously over a 7d window.
      - uid: vpn-peer-lost
        title: "VPN peer lost and not reconnected"
        condition: C
        data:
          - refId: A
            datasourceUid: loki
            relativeTimeRange:
              from: 604800
              to: 0
            model:
              expr: >-
                (sum by (site, iface) (count_over_time({job="unifi"}
                |~ `via wg(clt|sts)[0-9]+ .*\) disconnected`
                | regexp `via (?P<iface>wg[a-z0-9]+) ` [7d])))
                -
                ((sum by (site, iface) (count_over_time({job="unifi"}
                |~ `via wg(clt|sts)[0-9]+ .*\) connected`
                | regexp `via (?P<iface>wg[a-z0-9]+) ` [7d])))
                or
                ((sum by (site, iface) (count_over_time({job="unifi"}
                |~ `via wg(clt|sts)[0-9]+ .*\) disconnected`
                | regexp `via (?P<iface>wg[a-z0-9]+) ` [7d]))) * 0))
              instant: true
          - refId: B
            datasourceUid: "__expr__"
            model:
              type: reduce
              expression: "A"
              reducer: last
              settings:
                mode: dropNN
          - refId: C
            datasourceUid: "__expr__"
            model:
              type: threshold
              expression: "B"
              conditions:
                - evaluator: { type: gt, params: [0] }
        noDataState: OK
        execErrState: Alerting
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "WireGuard peer on {{ '{{' }} $labels.iface {{ '}}' }} at {{ '{{' }} $labels.site {{ '}}' }} has not reconnected"
          description: >-
            Over the last 7 days this tunnel logged more peer disconnects than
            reconnects — it dropped and never came back. Roaming laptops and
            phones (wgsrv*) are deliberately excluded from this rule, so this is
            an always-on inter-site link, not normal client churn. Devices
            policy-routed over it are silently falling back to their local WAN:
            still online, but egressing from the wrong site. Check the peer
            endpoint still resolves, then toggle the tunnel on the gateway to
            force a re-handshake.
