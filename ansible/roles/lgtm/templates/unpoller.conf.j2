# Managed by Ansible — do not edit manually.
# Template: roles/lgtm/templates/unpoller.conf.j2
# Site: {{ unpoller_site.name }} ({{ unpoller_site.site }}) — rendered once per unpoller_sites entry.

[poller]
  debug    = false
  quiet    = false

[prometheus]
  disable     = false
  namespace   = "unifi"
  http_listen = "0.0.0.0:{{ unpoller_port }}"

[influxdb]
  disable = true

[unifi]
  [unifi.defaults]
    verify_ssl = false
    save_sites = true
    save_dpi   = false

  [[unifi.controller]]
    url  = "{{ unpoller_site.url }}"
    user = "{{ unpoller_site.user }}"
    pass = "{{ unpoller_site.pass }}"
