# Managed by Ansible — do not edit manually.
# Template: roles/lgtm/templates/unpoller.env.j2

# Prometheus output
UP_PROMETHEUS_DISABLE=false
UP_PROMETHEUS_NAMESPACE=unifi
UP_PROMETHEUS_HTTP_LISTEN=0.0.0.0:{{ unpoller_port }}

# Disable InfluxDB (not used)
UP_INFLUXDB_DISABLE=true

# Site 1 controller
UP_UNIFI_0_URL={{ unifi_controller_url_site1 }}
UP_UNIFI_0_USER={{ vault_unifi_username_site1 }}
UP_UNIFI_0_PASS={{ vault_unifi_password_site1 }}
UP_UNIFI_0_VERIFY_SSL=false
UP_UNIFI_0_SAVE_SITES=true
UP_UNIFI_0_SAVE_DPI=false

# Site 2 controller
UP_UNIFI_1_URL={{ unifi_controller_url_site2 }}
UP_UNIFI_1_USER={{ vault_unifi_username_site2 }}
UP_UNIFI_1_PASS={{ vault_unifi_password_site2 }}
UP_UNIFI_1_VERIFY_SSL=false
UP_UNIFI_1_SAVE_SITES=true
UP_UNIFI_1_SAVE_DPI=false
