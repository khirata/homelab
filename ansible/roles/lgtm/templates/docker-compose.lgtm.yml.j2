---
# Managed by Ansible — do not edit manually.
# Template: roles/lgtm/templates/docker-compose.lgtm.yml.j2

# Shared by every unpoller-<name> service below; each site adds only its name
# and config file.
x-unpoller: &unpoller
  image: ghcr.io/unpoller/unpoller:{{ unpoller_version }}
  restart: unless-stopped
  networks:
    - lgtm
  healthcheck:
    disable: true

networks:
  lgtm:
    driver: bridge

volumes:
  grafana_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: {{ siem_data_dir }}/grafana
  loki_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: {{ siem_data_dir }}/loki
  prometheus_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: {{ siem_data_dir }}/prometheus
  pushgateway_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: {{ siem_data_dir }}/pushgateway

services:
  grafana:
    image: grafana/grafana:{{ grafana_version }}
    container_name: grafana
    restart: unless-stopped
    networks:
      - lgtm
    ports:
      - "{{ grafana_port }}:3000"
    environment:
      GF_SECURITY_ADMIN_PASSWORD: "{{ vault_grafana_admin_password }}"
      GF_PATHS_PROVISIONING: /etc/grafana/provisioning
      GF_PATHS_CONFIG: /etc/grafana/grafana.ini
    volumes:
      - grafana_data:/var/lib/grafana
      - {{ siem_config_dir }}/grafana.ini:/etc/grafana/grafana.ini:ro
      - {{ siem_config_dir }}/grafana-provisioning:/etc/grafana/provisioning:ro
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O - http://localhost:3000/api/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 15s
    depends_on:
      - loki
      - prometheus

  loki:
    image: grafana/loki:{{ loki_version }}
    container_name: loki
    restart: unless-stopped
    networks:
      - lgtm
    ports:
      - "{{ loki_port }}:3100"  # exposed for Alloy remote_write from nodes
    volumes:
      - loki_data:/loki
      - {{ siem_config_dir }}/loki-config.yaml:/etc/loki/local-config.yaml:ro
    command: -config.file=/etc/loki/local-config.yaml
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O - http://localhost:3100/ready || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s

  prometheus:
    image: prom/prometheus:{{ prometheus_version }}
    container_name: prometheus
    restart: unless-stopped
    networks:
      - lgtm
    ports:
      - "{{ prometheus_port }}:9090"  # exposed for Alloy remote_write from nodes
    volumes:
      - prometheus_data:/prometheus
      - {{ siem_config_dir }}/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - {{ siem_config_dir }}/prometheus-targets:/etc/prometheus/targets:ro
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=30d
      - --web.enable-remote-write-receiver
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O - http://localhost:9090/-/healthy || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s

  # Receives metrics from jobs Prometheus cannot scrape — today udm_v4v6 on
  # sak2, which reaches this host only over Tailscale. Persisted so a restart
  # keeps the last push and its push_time_seconds (an empty Pushgateway would
  # look like "no data" rather than "stale").
  pushgateway:
    image: prom/pushgateway:{{ pushgateway_version }}
    container_name: pushgateway
    restart: unless-stopped
    networks:
      - lgtm
    ports:
      - "{{ pushgateway_port }}:9091"
    volumes:
      - pushgateway_data:/data
    command:
      - --persistence.file=/data/pushgateway.db
      - --persistence.interval=5m
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O - http://localhost:9091/-/healthy || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
{% for site in unpoller_sites %}

  unpoller-{{ site.name }}:
    <<: *unpoller
    container_name: unpoller-{{ site.name }}
    volumes:
      - {{ siem_config_dir }}/unpoller/{{ site.name }}.conf:/etc/unpoller/up.conf:ro
{% endfor %}
