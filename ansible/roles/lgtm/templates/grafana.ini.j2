# Managed by Ansible — do not edit manually.
# Template: roles/lgtm/templates/grafana.ini.j2

[server]
http_port = 3000
# Bind to all interfaces so the host port mapping works
http_addr =
{% if grafana_external_url %}
root_url = {{ grafana_external_url }}
serve_from_sub_path = false
{% endif %}

[security]
# Admin password is set via GF_SECURITY_ADMIN_PASSWORD env var in Docker Compose.
# Do not set admin_password here.
admin_user = admin
disable_gravatar = true
cookie_secure = {% if grafana_external_url and grafana_external_url.startswith('https') %}true{% else %}false{% endif %}

[paths]
provisioning = /etc/grafana/provisioning

[log]
mode = console
level = info

[analytics]
reporting_enabled = false
check_for_updates = false
check_for_plugin_updates = false

[users]
allow_sign_up = false

[smtp]
enabled = true
host = {{ smtp_host }}
from_address = {{ smtp_from }}
from_name = Grafana Homelab
startTLS_policy = {{ smtp_starttls_policy }}

{% if cloudflare_team_name %}
# Cloudflare Access JWT auth — users authenticate at the tunnel; Grafana trusts the signed JWT.
# Grafana fetches the JWKS from Cloudflare on first use and caches it.
[auth.jwt]
enabled = true
header_name = Cf-Access-Jwt-Assertion
email_claim = email
jwk_set_url = https://{{ cloudflare_team_name }}.cloudflareaccess.com/cdn-cgi/access/certs
auto_sign_up = true

# Disable the login form when Cloudflare Access is the sole auth layer.
[auth]
disable_login_form = true
{% endif %}
