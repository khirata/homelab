# Managed by Ansible — do not edit manually.
# Template: roles/lgtm/templates/prometheus.yml.j2

global:
  scrape_interval: 60s
  evaluation_interval: 60s
  scrape_timeout: 10s

scrape_configs:
  # One target per unpoller_sites entry, each labelled site=<site>. Adding a
  # site writes a file here; this config is not touched.
  - job_name: unpoller
    scrape_interval: 30s
    file_sd_configs:
      - files: ['/etc/prometheus/targets/unpoller/*.yml']

  # Pushed metrics keep the job/site they were pushed with (honor_labels), so
  # udm_v4v6 series carry job="udm_v4v6", not job="pushgateway".
  - job_name: pushgateway
    honor_labels: true
    static_configs:
      - targets: ['pushgateway:9091']
