# Managed by Ansible — do not edit manually.
# Template: roles/lgtm/templates/prometheus.yml.j2

global:
  scrape_interval: 60s
  evaluation_interval: 60s
  scrape_timeout: 10s

scrape_configs:
  - job_name: alloy
    static_configs:
{% for item in prometheus_scrape_targets %}
      - targets: ["{{ item.target }}"]
        labels:
          instance: "{{ item.instance }}"
{% endfor %}
