// Managed by Ansible — do not edit manually.
// Template: roles/alloy/templates/alloy-minimal.alloy.j2
// Mode: minimal (RPi Zero 2W) — journal logs to Loki only, no node_exporter

// ── Systemd journal → Loki ──────────────────────────────────────────────
loki.source.journal "systemd" {
  forward_to    = [loki.write.siem.receiver]
  relabel_rules = loki.relabel.journal.rules
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  // ── service_name: cascaded fallback ──────────────────────────────────────
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "^(.+?)(?:@[^.]*)?\.(?:service|socket|timer)$"
    target_label  = "service_name"
  }

  rule {
    source_labels = ["service_name", "__journal__syslog_identifier"]
    regex         = "^;(.+)$"
    target_label  = "service_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["service_name", "__journal__transport"]
    regex         = "^;(kernel|audit)$"
    target_label  = "service_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["service_name", "__journal__comm"]
    regex         = "^;(.+)$"
    target_label  = "service_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }

  rule {
    replacement  = "journal"
    target_label = "job"
  }

  rule {
    replacement  = "{{ ansible_hostname }}"
    target_label = "instance"
  }
}

// ── Loki write → siem ────────────────────────────────────────────────────
loki.write "siem" {
  endpoint {
    url = "http://{{ siem_server_ip }}:{{ loki_port }}/loki/api/v1/push"
  }
}
