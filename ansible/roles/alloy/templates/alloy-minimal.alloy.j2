// Managed by Ansible — do not edit manually.
// Template: roles/alloy/templates/alloy-minimal.alloy.j2
// Mode: minimal (RPi Zero 2W) — journal logs to Loki only, no node_exporter

// ── Systemd journal → Loki ──────────────────────────────────────────────
loki.source.journal "systemd" {
  forward_to    = [loki.write.siem.receiver]
  relabel_rules = loki.relabel.journal.rules
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }

  rule {
    replacement  = "journal"
    target_label = "job"
  }

  rule {
    replacement  = "{{ ansible_hostname }}"
    target_label = "instance"
  }
}

// ── Loki write → siem ────────────────────────────────────────────────────
loki.write "siem" {
  endpoint {
    url = "http://{{ siem_server_ip }}:{{ loki_port }}/loki/api/v1/push"
  }
}
