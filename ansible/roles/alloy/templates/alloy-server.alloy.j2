// Managed by Ansible — do not edit manually.
// Template: roles/alloy/templates/alloy-server.alloy.j2
// Mode: server (siem) — exports local node metrics + receives Unifi syslog

// ── Alloy UI / self-metrics ───────────────────────────────────────────────
prometheus.exporter.self "alloy" {}

prometheus.scrape "alloy_self" {
  targets    = prometheus.exporter.self.alloy.targets
  forward_to = [prometheus.remote_write.siem.receiver]
}

// ── Node metrics (via unix exporter) ────────────────────────────────────
prometheus.exporter.unix "node" {
  textfile {
    directory = "/var/lib/node_exporter/textfile_collector"
  }
}

prometheus.scrape "node" {
  targets    = prometheus.exporter.unix.node.targets
  forward_to = [prometheus.relabel.node_instance.receiver]
  job_name   = "node"
}

prometheus.relabel "node_instance" {
  forward_to = [prometheus.remote_write.siem.receiver]

  rule {
    target_label = "instance"
    replacement  = "{{ ansible_hostname }}"
  }

  // prometheus.exporter.unix defaults to job="integrations/unix"; force it to "node"
  rule {
    target_label = "job"
    replacement  = "node"
  }
}

// ── Prometheus remote write → local Prometheus ──────────────────────────
prometheus.remote_write "siem" {
  endpoint {
    url = "http://localhost:{{ prometheus_port }}/api/v1/write"
  }
}

// ── Unifi syslog receivers → Loki ───────────────────────────────────────
// Each site gets its own port so logs carry an indexed 'site' label.
// Lafayette GW → :{{ unifi_syslog_port_laf }}
// Sakamoto GW  → :{{ unifi_syslog_port_sak }}  (expand with more sak hosts later)
loki.source.syslog "unifi_laf" {
  listener {
    address       = "0.0.0.0:{{ unifi_syslog_port_laf }}"
    protocol      = "udp"
    syslog_format = "rfc3164"  // Unifi sends BSD syslog, not RFC5424
    labels        = { job = "unifi", site = "lafayette" }
  }
  relabel_rules = loki.relabel.unifi_syslog.rules
  forward_to    = [loki.process.unifi_syslog.receiver]
}

loki.source.syslog "unifi_sak" {
  listener {
    address       = "0.0.0.0:{{ unifi_syslog_port_sak }}"
    protocol      = "udp"
    syslog_format = "rfc3164"
    labels        = { job = "unifi", site = "sakamoto" }
  }
  relabel_rules = loki.relabel.unifi_syslog.rules
  forward_to    = [loki.process.unifi_syslog.receiver]
}

// Attach a 'host' label to Unifi syslog.
// Without it, syslog streams carry only {job, site} — every device at a site
// collapses into one unattributed stream, and the Log Explorer "Host" dropdown
// (built from the 'host' label) never lists any gateway.
// Cardinality is bounded: a handful of GW/AP/switch hostnames per site.
loki.relabel "unifi_syslog" {
  forward_to = []

  rule {
    source_labels = ["__syslog_message_hostname"]
    target_label  = "host"
  }
}

// Unifi's RFC3164 output is inconsistent: measured against live traffic, the
// syslog parser populates __syslog_message_hostname for only ~1/3 of lines.
// Labelling just those would be worse than labelling none — the dropdown would
// look functional while silently hiding two thirds of a device's logs.
//
// Every message body does begin with the device name, so recover it there for
// the remainder. stage.match limits this to lines the parser could not resolve,
// because on lines it DID resolve the body may start with the process tag
// instead ("hostapd[10291]: ...").
//
// Two guards keep a WRONG host out, which would be worse than a missing one:
//   - the next token must look like a syslog tag ("systemd[1]:", "kernel:") or
//     a bracketed prefix ("[PREROUTING-DNAT-5]");
//   - the host token must contain a dot or hyphen, so prose like
//     "mem avail: 1813 of 3946 MiB" cannot yield host=mem.
// A device named without a dot or hyphen therefore falls back to no label
// rather than a wrong one; the parser rule above still covers what it can.
loki.process "unifi_syslog" {
  forward_to = [loki.write.siem.receiver]

  stage.match {
    selector = "{host=\"\"}"

    stage.regex {
      expression = "^(?P<host>[A-Za-z0-9][A-Za-z0-9._-]*[.-][A-Za-z0-9._-]*) (?:[A-Za-z0-9._/-]+[\\[:]|\\[)"
    }

    stage.labels {
      values = { host = "" }
    }
  }
}

// ── Systemd journal → Loki ──────────────────────────────────────────────
loki.source.journal "systemd" {
  forward_to    = [loki.write.siem.receiver]
  relabel_rules = loki.relabel.journal.rules
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  // ── service_name: cascaded fallback ──────────────────────────────────────
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "^(.+?)(?:@[^.]*)?[.](?:service|socket|timer)$"
    target_label  = "service_name"
  }

  rule {
    source_labels = ["service_name", "__journal__syslog_identifier"]
    regex         = "^;(.+)$"
    target_label  = "service_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["service_name", "__journal__transport"]
    regex         = "^;(kernel|audit)$"
    target_label  = "service_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["service_name", "__journal__comm"]
    regex         = "^;(.+)$"
    target_label  = "service_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }

  rule {
    replacement  = "journal"
    target_label = "job"
  }

  rule {
    replacement  = "{{ ansible_hostname }}"
    target_label = "instance"
  }
}

{% if alloy_pg_log_dir %}
// ── PostgreSQL log files → Loki ─────────────────────────────────────────
// logging_collector=on writes to files, bypassing the systemd journal.
local.file_match "pg_logs" {
  path_targets = [{"__path__" = "{{ alloy_pg_log_dir }}/*.log"}]
}

loki.source.file "pg_logs" {
  targets    = local.file_match.pg_logs.targets
  forward_to = [loki.relabel.pg_logs.receiver]
}

loki.relabel "pg_logs" {
  forward_to = [loki.write.siem.receiver]

  rule {
    replacement  = "postgresql"
    target_label = "job"
  }

  rule {
    replacement  = "{{ ansible_hostname }}"
    target_label = "instance"
  }
}
{% endif %}

// ── Docker container logs → Loki ────────────────────────────────────────
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  forward_to    = [loki.relabel.docker_meta.receiver]
  relabel_rules = loki.relabel.docker_meta.rules
}

loki.relabel "docker_meta" {
  forward_to = [loki.write.siem.receiver]

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
  }

  rule {
    replacement  = "docker"
    target_label = "job"
  }
}

// ── Loki write → local Loki ─────────────────────────────────────────────
loki.write "siem" {
  endpoint {
    url = "http://localhost:{{ loki_port }}/loki/api/v1/push"
  }
}
