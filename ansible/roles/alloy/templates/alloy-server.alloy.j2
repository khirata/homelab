// Managed by Ansible — do not edit manually.
// Template: roles/alloy/templates/alloy-server.alloy.j2
// Mode: server (laf3) — exports local node metrics + receives Unifi syslog

// ── Alloy UI / self-metrics ───────────────────────────────────────────────
prometheus.exporter.self "alloy" {}

prometheus.scrape "alloy_self" {
  targets    = prometheus.exporter.self.alloy.targets
  forward_to = [prometheus.remote_write.laf3.receiver]
}

// ── Node metrics (via unix exporter) ────────────────────────────────────
prometheus.exporter.unix "node" {
  textfile {
    directory = "/var/lib/node_exporter/textfile_collector"
  }
}

prometheus.scrape "node" {
  targets    = prometheus.exporter.unix.node.targets
  forward_to = [prometheus.relabel.node_instance.receiver]
  job_name   = "node"
}

prometheus.relabel "node_instance" {
  forward_to = [prometheus.remote_write.laf3.receiver]

  rule {
    target_label = "instance"
    replacement  = "{{ node_name }}"
  }
}

// ── Prometheus remote write → local Prometheus ──────────────────────────
prometheus.remote_write "laf3" {
  endpoint {
    url = "http://localhost:{{ prometheus_port }}/api/v1/write"
  }
}

// ── Unifi syslog receivers → Loki ───────────────────────────────────────
// Each site gets its own port so logs carry an indexed 'site' label.
// Lafayette GW → :{{ unifi_syslog_port_laf }}
// Sakamoto GW  → :{{ unifi_syslog_port_sak }}  (expand with more sak hosts later)
loki.source.syslog "unifi_laf" {
  listener {
    address       = "0.0.0.0:{{ unifi_syslog_port_laf }}"
    protocol      = "udp"
    syslog_format = "rfc3164"  // Unifi sends BSD syslog, not RFC5424
    labels        = { job = "unifi", site = "lafayette" }
  }
  forward_to = [loki.write.laf3.receiver]
}

loki.source.syslog "unifi_sak" {
  listener {
    address       = "0.0.0.0:{{ unifi_syslog_port_sak }}"
    protocol      = "udp"
    syslog_format = "rfc3164"
    labels        = { job = "unifi", site = "sakamoto" }
  }
  forward_to = [loki.write.laf3.receiver]
}

// ── Systemd journal → Loki ──────────────────────────────────────────────
loki.source.journal "systemd" {
  forward_to    = [loki.write.laf3.receiver]
  relabel_rules = loki.relabel.journal.rules
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }

  rule {
    replacement  = "journal"
    target_label = "job"
  }

  rule {
    replacement  = "{{ node_name }}"
    target_label = "instance"
  }
}

// ── Loki write → local Loki ─────────────────────────────────────────────
loki.write "laf3" {
  endpoint {
    url = "http://localhost:{{ loki_port }}/loki/api/v1/push"
  }
}
