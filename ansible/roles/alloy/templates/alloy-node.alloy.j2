// Managed by Ansible — do not edit manually.
// Template: roles/alloy/templates/alloy-node.alloy.j2
// Mode: node — ships systemd journal logs and node metrics to siem

// ── Alloy UI / self-metrics ───────────────────────────────────────────────
prometheus.exporter.self "alloy" {}

prometheus.scrape "alloy_self" {
  targets    = prometheus.exporter.self.alloy.targets
  forward_to = [prometheus.remote_write.siem.receiver]
}

// ── Node metrics (via unix exporter) ────────────────────────────────────
prometheus.exporter.unix "node" {
{% if alloy_textfile_dir is defined and alloy_textfile_dir %}
  textfile {
    directory = "{{ alloy_textfile_dir }}"
  }
{% endif %}
}

prometheus.scrape "node" {
  targets    = prometheus.exporter.unix.node.targets
  forward_to = [prometheus.relabel.node_instance.receiver]
  job_name   = "node"
}

prometheus.relabel "node_instance" {
  forward_to = [prometheus.remote_write.siem.receiver]

  rule {
    target_label = "instance"
    replacement  = "{{ ansible_hostname }}"
  }

  // prometheus.exporter.unix defaults to job="integrations/unix"; force it to "node"
  rule {
    target_label = "job"
    replacement  = "node"
  }
}

{% if alloy_redis_addr %}
// ── Redis metrics ───────────────────────────────────────────────────────
// Alloy embeds oliver006/redis_exporter, so no separate exporter service is
// needed — metrics ride the same remote_write path as node metrics.
prometheus.exporter.redis "redis" {
  redis_addr     = "{{ alloy_redis_addr }}"
  redis_password = "{{ vault_redis_password }}"
}

prometheus.scrape "redis" {
  targets    = prometheus.exporter.redis.redis.targets
  forward_to = [prometheus.relabel.redis_instance.receiver]
  job_name   = "redis"
}

prometheus.relabel "redis_instance" {
  forward_to = [prometheus.remote_write.siem.receiver]

  // The exporter reports instance="{{ alloy_redis_addr }}", which is identical
  // on every host; use the hostname so the dashboard's $instance is meaningful.
  rule {
    replacement  = "{{ ansible_hostname }}"
    target_label = "instance"
  }

  // prometheus.exporter.redis defaults to job="integrations/redis"; force it to
  // "redis". job_name on the scrape above does not override the exporter's own
  // label — same reason the unix exporter needs this rule.
  rule {
    target_label = "job"
    replacement  = "redis"
  }
}

{% endif %}
// ── Prometheus remote write → siem ──────────────────────────────────────
prometheus.remote_write "siem" {
  endpoint {
    url = "http://{{ siem_server_ip }}:{{ prometheus_port }}/api/v1/write"
  }
}

// ── Systemd journal → Loki ──────────────────────────────────────────────
loki.source.journal "systemd" {
  forward_to = [loki.write.siem.receiver]
  relabel_rules = loki.relabel.journal.rules
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  // ── service_name: cascaded fallback ──────────────────────────────────────
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "^(.+?)(?:@[^.]*)?[.](?:service|socket|timer)$"
    target_label  = "service_name"
  }

  rule {
    source_labels = ["service_name", "__journal__syslog_identifier"]
    regex         = "^;(.+)$"
    target_label  = "service_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["service_name", "__journal__transport"]
    regex         = "^;(kernel|audit)$"
    target_label  = "service_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["service_name", "__journal__comm"]
    regex         = "^;(.+)$"
    target_label  = "service_name"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }

  rule {
    replacement  = "journal"
    target_label = "job"
  }

  rule {
    replacement  = "{{ ansible_hostname }}"
    target_label = "instance"
  }
}

{% if alloy_pg_log_dir %}
// ── PostgreSQL log files → Loki ─────────────────────────────────────────
// logging_collector=on writes to files, bypassing the systemd journal.
local.file_match "pg_logs" {
  path_targets = [{"__path__" = "{{ alloy_pg_log_dir }}/*.log"}]
}

loki.source.file "pg_logs" {
  targets    = local.file_match.pg_logs.targets
  forward_to = [loki.relabel.pg_logs.receiver]
}

loki.relabel "pg_logs" {
  forward_to = [loki.write.siem.receiver]

  rule {
    replacement  = "postgresql"
    target_label = "job"
  }

  rule {
    replacement  = "{{ ansible_hostname }}"
    target_label = "instance"
  }
}
{% endif %}

// ── Loki write → siem ────────────────────────────────────────────────────
loki.write "siem" {
  endpoint {
    url = "http://{{ siem_server_ip }}:{{ loki_port }}/loki/api/v1/push"
  }
}
