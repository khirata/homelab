// Managed by Ansible — do not edit manually.
// Template: roles/alloy/templates/alloy-node.alloy.j2
// Mode: node — ships systemd journal logs and node metrics to laf3

// ── Alloy UI / self-metrics ───────────────────────────────────────────────
prometheus.exporter.self "alloy" {}

prometheus.scrape "alloy_self" {
  targets    = prometheus.exporter.self.alloy.targets
  forward_to = [prometheus.remote_write.laf3.receiver]
}

// ── Node metrics (via unix exporter) ────────────────────────────────────
prometheus.exporter.unix "node" {}

prometheus.scrape "node" {
  targets    = prometheus.exporter.unix.node.targets
  forward_to = [prometheus.remote_write.laf3.receiver]
  job_name   = "node"
}

// ── Prometheus remote write → laf3 ──────────────────────────────────────
prometheus.remote_write "laf3" {
  endpoint {
    url = "http://{{ siem_server_ip }}:{{ prometheus_port }}/api/v1/write"
  }
}

// ── Systemd journal → Loki ──────────────────────────────────────────────
loki.source.journal "systemd" {
  forward_to = [loki.write.laf3.receiver]
  relabel_rules = loki.relabel.journal.rules
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "host"
  }

  rule {
    replacement  = "journal"
    target_label = "job"
  }

  rule {
    replacement  = "{{ inventory_hostname }}"
    target_label = "instance"
  }
}

// ── Loki write → laf3 ────────────────────────────────────────────────────
loki.write "laf3" {
  endpoint {
    url = "http://{{ siem_server_ip }}:{{ loki_port }}/loki/api/v1/push"
  }
}
