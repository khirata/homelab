# Managed by Ansible — do not edit manually.
# Source: roles/udm_v4v6/files/udm_v4v6.service

[Unit]
Description=Push UDM-SE WAN IPv4/IPv6 byte counters to Pushgateway
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/default/udm_v4v6
ExecStart=/usr/local/bin/udm_v4v6.sh
SyslogIdentifier=udm_v4v6
# Must finish well inside the 1-minute timer period.
TimeoutStartSec=50

# Unprivileged system user (created by the role). Not DynamicUser: sak2's
# nsswitch has no libnss-systemd, so a dynamic UID has no passwd entry and
# ssh refuses to start. The key stays root-only on disk and is handed over
# through $CREDENTIALS_DIRECTORY; the accumulator state lives in StateDirectory.
User=udm-v4v6
Group=udm-v4v6
LoadCredential=udm_key:/etc/udm_v4v6/id_ed25519
StateDirectory=udm_v4v6
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
