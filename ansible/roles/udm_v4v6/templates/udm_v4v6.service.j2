# Managed by Ansible — do not edit manually.
# Template: roles/udm_v4v6/templates/udm_v4v6.service.j2

[Unit]
Description=Read UDM-SE WAN IPv4/IPv6 byte counters for Alloy's textfile collector
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=oneshot
EnvironmentFile=/etc/default/udm_v4v6
ExecStart=/usr/local/bin/udm_v4v6.sh
SyslogIdentifier=udm_v4v6
# Must finish well inside the 1-minute timer period.
TimeoutStartSec=50

# Unprivileged system user (created by the role). Not DynamicUser: this host's
# nsswitch has no libnss-systemd, so a dynamic UID has no passwd entry and ssh
# refuses to start. The key stays root-only on disk and is handed over through
# $CREDENTIALS_DIRECTORY; the accumulator state lives in StateDirectory; the
# only other writable path is the textfile directory (ACL set by the role).
User=udm-v4v6
Group=udm-v4v6
LoadCredential=udm_key:/etc/udm_v4v6/id_ed25519
StateDirectory=udm_v4v6
ReadWritePaths={{ udm_v4v6_textfile_dir }}
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
