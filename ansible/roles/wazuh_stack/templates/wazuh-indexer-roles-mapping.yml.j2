# Managed by Ansible — do not edit manually.
# Template: roles/wazuh_stack/templates/wazuh-indexer-roles-mapping.yml.j2

_meta:
  type: "rolesmapping"
  config_version: 2

all_access:
  reserved: false
  backend_roles:
    - admin
  users:
    # kibanaserver needs all_access so the dashboard can manage wazuh-monitoring-*,
    # wazuh-statistics-*, and other Wazuh plugin indices (kibana_server role alone
    # only covers .kibana/.opensearch_dashboards index patterns).
    - kibanaserver
  description: "Maps admin backend role and kibanaserver user to all_access"

own_index:
  reserved: false
  users:
    - "*"
  description: "Allow full access to an index named like the username"

kibana_server:
  reserved: true
  users:
    - kibanaserver

kibana_user:
  reserved: false
  backend_roles:
    - kibanauser
  description: "Maps kibanauser to kibana_user role"

logstash:
  reserved: false
  backend_roles:
    - logstash

readall:
  reserved: false
  backend_roles:
    - readall

manage_snapshots:
  reserved: false
  backend_roles:
    - snapshotrestore
