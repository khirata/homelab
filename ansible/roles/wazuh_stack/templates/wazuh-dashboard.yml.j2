# Managed by Ansible — do not edit manually.
# Template: roles/wazuh_stack/templates/wazuh-dashboard.yml.j2

server.host: 0.0.0.0
server.port: 5601
server.name: wazuh-dashboard

opensearch.hosts:
  - https://wazuh-indexer:9200
# opensearch.username / .password are set via keystore by the entrypoint
# (DASHBOARD_USERNAME / DASHBOARD_PASSWORD env vars → opensearch-dashboards-keystore).
opensearch.ssl.verificationMode: certificate
opensearch.ssl.certificateAuthorities:
  - /usr/share/wazuh-dashboard/certs/root-ca.pem

# Forward proxy auth headers to the OpenSearch backend when making scoped API calls.
# By default OSD only forwards 'authorization'; without this, x-proxy-user/roles are
# stripped and the indexer sees a null user, causing 401s.
opensearch.requestHeadersWhitelist:
  - authorization
  - x-proxy-user
  - x-proxy-roles
  - x-forwarded-for

# Proxy auth — trust x-proxy-user / x-proxy-roles injected by nginx-cf-proxy.
# The nginx sidecar validates the Cloudflare Access JWT and injects these headers.
# No login form is shown; authentication is fully delegated to Cloudflare Access.
opensearch_security.auth.type: "proxy"
opensearch_security.proxycache.user_header: "x-proxy-user"
opensearch_security.proxycache.roles_header: "x-proxy-roles"

server.ssl.enabled: false

logging.dest: stdout
logging.silent: false
logging.verbose: false

uiSettings.overrides.defaultRoute: /app/wazuh
