# Managed by Ansible — do not edit manually.
# Template: roles/redis/templates/redis.conf.j2

# Network — bind all interfaces so Docker containers can reach via host-gateway
bind {{ redis_bind }}
port {{ redis_port }}
protected-mode yes
requirepass {{ vault_redis_password }}

# Persistence — RDB snapshots
save 3600 1
save 300 100
save 60 10000
dir /var/lib/redis
dbfilename dump.rdb
rdbcompression yes

# Logging
loglevel notice
logfile /var/log/redis/redis-server.log

# Memory
maxmemory-policy noeviction
