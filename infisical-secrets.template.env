# Canonical list of the secrets that live in the Infisical "prod" environment.
#
# This file is the source of truth for WHICH secrets must exist and WHAT each one
# requires. Values are always blank here — it is committed.
#
# Two consumers:
#   1. `make _infisical-check` (a prerequisite of every deploy) fails if any key
#      below is missing from Infisical, catching a key renamed or dropped in the UI.
#   2. `infisical secrets set --file` imports it, so a fresh project can be
#      populated in one shot.
#
# Conventions:
#   KEY=          required — the guard fails when it is absent from Infisical
#   # KEY=        optional or unused — documented, never enforced
#
# ---------------------------------------------------------------------------
# IMPORTING
#
#   cp infisical-secrets.template.env /tmp/secrets.env   # fill in the values
#   infisical secrets set --file /tmp/secrets.env \
#     --projectId $INFISICAL_PROJECT_ID --env prod --domain $INFISICAL_API_URL
#   shred -u /tmp/secrets.env
#
# DANGER: `secrets set --file` is an upsert, not a create. Pointing it at THIS
# file — or any copy with blank values — overwrites every listed secret with an
# empty string, and `_infisical-check` still passes because the keys exist.
# Only ever pass it a filled-in copy outside the repo.
#
# Not listed here: bootstrap secrets and connection/config vars that live in
# .env because Infisical cannot supply them. See .env.example.
# ---------------------------------------------------------------------------

# === Connection (duplicated in .env for bootstrap; Infisical serves normal deploys) ===

# LAN IP of the SIEM server — becomes ansible_host
SIEM_SERVER_IP=

# SSH user on the SIEM server — becomes ansible_user
SIEM_SERVER_USER=

# LAN IP of the Redis host
REDIS_SERVER_IP=

# SSH user on the Redis host
REDIS_SERVER_USER=

# === Grafana ===

# Grafana admin login password
GRAFANA_ADMIN_PASSWORD=

# === SMTP — Google Workspace relay (IP-based auth, no password needed) ===

# Relay address and port, e.g. smtp.yourdomain.com:587
SMTP_HOST=

# Sender address — must be a valid address in your Google Workspace domain
SMTP_FROM=

# MandatoryStartTLS | OpportunisticStartTLS | NoStartTLS  (Grafana only)
SMTP_STARTTLS_POLICY=

# === Wazuh ===

# Wazuh REST API password for the 'wazuh' admin user
# Requirements: min 1 uppercase, 1 lowercase, 1 digit, 1 symbol
WAZUH_API_PASSWORD=

# OpenSearch 'admin' superuser password
# Requirements: min 12 chars, mix of upper/lower/digit/symbol
# Generate: openssl rand -base64 16
WAZUH_INDEXER_ADMIN_PASSWORD=

# 'kibanaserver' service account password (dashboard → indexer auth)
# Generate: openssl rand -base64 16
WAZUH_KIBANASERVER_PASSWORD=

# bcrypt hashes of the two passwords above, for internal_users.yml.
# Generate ONCE, after setting the passwords:
#   docker run --rm wazuh/wazuh-indexer:4.14.5 \
#     bash plugins/opensearch-security/tools/hash.sh -p <password>
WAZUH_INDEXER_ADMIN_HASH=
WAZUH_KIBANASERVER_HASH=

# Public URL the Cloudflare Tunnel exposes the Wazuh Dashboard at.
# Optional — vars.yml defaults it to empty.
WAZUH_DASHBOARD_EXTERNAL_URL=

# Agent enrollment password (authd.pass). Optional: the default setup uses open
# enrollment and no role reads this today.
# WAZUH_ENROLLMENT_PASSWORD=

# === Unifi (Unpoller) ===
# Read-only local user in each controller. The controller URLs live in .env.
# UnifiOS (UDM/Dream Machine): Settings → Admins → Add Admin → Role: Read Only

UNIFI_USERNAME_SITE1=
UNIFI_PASSWORD_SITE1=
UNIFI_USERNAME_SITE2=
UNIFI_PASSWORD_SITE2=

# === Alerting ===

# Email address that receives Grafana alerts (uses the SMTP config above)
ALERT_EMAIL=

# Discord incoming webhook
# Create at: Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=

# === ntfy ===

# Access token for the self-hosted ntfy server on laf2.
# Bootstrap once, after deploying the ntfy_server role:
#   ssh laf2 sudo ntfy user add --role=admin admin
#   ssh laf2 sudo ntfy token add --expires=0 admin
NTFY_TOKEN=

# ntfy.sh cloud fallback topic. ntfy.sh topics are public, so an unpredictable
# name is the only privacy layer — append a random suffix.
# Generate the suffix: openssl rand -hex 4     e.g. homelab-f3k9xp2m
NTFY_CLOUD_TOPIC=

# === Infrastructure passwords (also in .env for bootstrap) ===

# PostgreSQL password for the infisical database user
# Requirements: min 16 chars, mix of letters and digits recommended
# Generate: openssl rand -base64 16
POSTGRESQL_PASSWORD=

# Redis password — embedded in the redis:// URL the infisical role renders.
# Requirements: min 32 chars; hex only — base64 chars (/ =) break URL parsing
# Generate: openssl rand -hex 32
REDIS_PASSWORD=

# === Present in Infisical but deliberately not enforced ===

# Hostname of the SIEM server. Defined in group_vars/all/vars.yml but no role
# templates it — README prose and CI mock vars are the only references.
# SIEM_SERVER_HOST=

# Infisical's own JWT signing secret. `make deploy-infisical` reads this from
# .env before Infisical exists, so .env is authoritative. A copy also exists in
# the project; if the two ever diverge, bootstrap and normal deploys would sign
# with different keys and invalidate sessions. Keep them identical, or drop the
# Infisical copy — docs/infisical.md says it should not be there at all.
# INFISICAL_AUTH_SECRET=
